# ═══════════════════════════════════════════════════════════════
# 全友·智绘家 —— 环境变量模板
# 复制为 .env 后填写。切勿把真实 key 提交进 git。
#
# 本文件与需求文档「第零章 环境实测基线」一一对应，
# 所有默认值都是本机实测可用的配置。
# ═══════════════════════════════════════════════════════════════

APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ── 本地部署约束（附录 B.6 / AC-37）────────────────────────────
# 决策：全部演示在本地完成，不做任何公网暴露。
# 端口一律绑回环；CORS 走白名单，禁止 ["*"]。
# ⚠️ 若 docker-compose 里写成 ["5432:5432"]（等价 0.0.0.0），
#    数据库会对整个局域网可见——本项目存的是用户上传的户型图。
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOW_LAN_ACCESS=false

# ── LLM ────────────────────────────────────────────────────────
# 本机唯一可用的多模态凭证。留空则自动降级到本地 Ollama。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# 实测坑：deepseek-flash 是思考模型，reasoning token 会先吃掉预算，
# max_tokens 给小了会返回空字符串（实测 179 token 里 169 个是 reasoning）。不要低于 2000。
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=120

# ── Ollama（宿主机原生，不在 Docker 里）────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# ⚠️ 实测：minicpm 只能读房间名，**不能产出合法结构化户型 JSON**
#    （会编造越界 bbox、虚构墙体、JSON 语法本身是坏的）。
#    因此它只用于降级路径，全量解析禁止自动降级——见 ADR-09。
OLLAMA_VISION_MODEL=minicpm-v4.6:latest
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=quentinz/bge-large-zh-v1.5:latest

# ── 降级与熔断 ─────────────────────────────────────────────────
ENABLE_DEGRADATION=true
AGENT_TIMEOUT_SECONDS=30

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CHECKPOINTER=true

# ── PostgreSQL ─────────────────────────────────────────────────
# 注意：本机 3306 已被原生 MySQL 8.0 占用，PG 用 5432 无冲突（第零章 0.5）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=qy
POSTGRES_PASSWORD=qy
POSTGRES_DB=quanyou

# ── 存储（D 盘仅 29GB 可用，统一放 E 盘）────────────────────────
CHROMA_PATH=E:/quanyou/data/chroma
UPLOAD_DIR=E:/quanyou/uploads
OUTPUT_DIR=E:/quanyou/outputs

# ── 图像生成 ───────────────────────────────────────────────────
# vector = 纯矢量渲染（必出，零依赖）；local_sd15 = AI 效果图（尽力）
IMAGE_PROVIDER=vector

# ⚠️ 实测可用显存仅 3.22GB（驱动口径），SD1.5+ControlNet 理论占用 3.56–3.96GB。
#    必须按 L0→L3 逐级降级，M0 的 bench_image.py 是硬门槛（附录 E）。
SD15_IMAGE_SIZE=512
SD15_STEPS=6

# AI 图上的热区 —— 默认关闭（ADR-10）
# conditioning 边缘图与生成图 Canny 边缘图之间，即使几何完全对齐，
# IoU 也可能只有 0.4–0.6。预设阈值会让功能整体失效，故默认关闭，
# 待 M5 用 20 张样本人工标注标定后再决定。默认行为：热区全部走矢量图。
IMAGE_HOTSPOT_ENABLED=false
IMAGE_HOTSPOT_IOU_THRESHOLD=

# ── Rerank（留空即关闭；填 http://localhost:9999 复用已部署服务）──
# ⚠️ 单吃 2.2–2.5GB 内存，用完即停
RERANK_URL=

# ── 模型下载源（huggingface.co 本机直连不通，实测 12s 超时）──────
HF_ENDPOINT=https://hf-mirror.com
