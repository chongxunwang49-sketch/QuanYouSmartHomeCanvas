

# ── 业务数据落库（2026-09-24 新增）──────────────────────────────
# 户型 / 方案 / 审计事件写进 PostgreSQL 的 house_layouts / design_plans
# / audit_logs 三张表。**建表不在应用启动时做**，首次部署先跑一次：
#
#     python scripts/init_db.py
#
# 关掉它（false）与"数据库连不上"是同一种行为：业务数据退回内存 + Redis
# （TTL 1 小时，重启即失），审计事件只落文件。**都不报错** —— 见
# backend/app/db/pool.py 的立场：库是加固，不是依赖。
ENABLE_DB=true